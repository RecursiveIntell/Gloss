{
  "name": "gloss",
  "private": true,
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "npm run test:unit && npm run test:contracts",
    "test:unit": "vitest run",
    "test:contracts": "node scripts/run_frontend_contract_tests.mjs",
    "test:gates": "bash validation/run_all_gloss_repair_gates.sh .",
    "verify": "python3 scripts/verify_release.py",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev:sm": "tauri dev --features semantic-memory-backend",
    "tauri:dev:sm-tq": "tauri dev --features semantic-memory-turbo-quant",
    "tauri:dev:release": "tauri dev --features semantic-memory-turbo-quant",
    "tauri:build:sm": "tauri build --features semantic-memory-backend",
    "tauri:build:sm-tq": "tauri build --features semantic-memory-turbo-quant",
    "tauri:build:release": "bash scripts/build-appimage.sh",
    "check:sm-tq-profile": "python3 scripts/check_gloss_sm_tq_fix.py .",
    "test:tauri:sm": "cargo test --manifest-path src-tauri/Cargo.toml --features semantic-memory-backend",
    "test:tauri:sm-tq": "cargo test --manifest-path src-tauri/Cargo.toml --features semantic-memory-turbo-quant",
    "test:tauri:release": "cargo test --manifest-path src-tauri/Cargo.toml --features semantic-memory-turbo-quant",
    "test:all:sm-tq": "npm run build && npm run check:sm-tq-profile && npm run test:tauri:sm && npm run test:tauri:sm-tq",
    "desktop-smoke": "python3 scripts/gloss_desktop_smoke_harness.py --repo .",
    "installer-smoke": "python3 validation/gloss_installer_smoke_gate.py --repo . --build"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-fs": "2.5.1",
    "@types/d3-force": "^3.0.10",
    "cmdk": "^1.0.0",
    "d3-force": "^3.0.0",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.12",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "2.11.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^4",
    "typescript": "~5.8.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.7"
  }
}
