{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gloss P31 Phase Report",
  "type": "object",
  "required": [
    "phase",
    "goal",
    "status",
    "files_inspected",
    "files_changed",
    "commands",
    "invariants",
    "unresolved_risks",
    "next_phase_ready"
  ],
  "properties": {
    "phase": {
      "type": "string"
    },
    "goal": {
      "type": "string"
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "blocked",
        "quarantined"
      ]
    },
    "files_inspected": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "cmd",
          "status"
        ],
        "properties": {
          "cmd": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "blocked",
              "skipped"
            ]
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "blocked"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "unresolved_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_phase_ready": {
      "type": "boolean"
    }
  }
}
